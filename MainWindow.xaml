<Window x:Class="MinanaMac.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Minana MAC Address Changer — Minana Tech" Width="1240" Height="920" MinWidth="1060" MinHeight="740" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101824" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="20,26,20,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Border Width="34" Height="34" Background="{StaticResource Accent}" CornerRadius="9" Margin="0,0,10,0"><TextBlock Text="M" FontWeight="Bold" FontSize="22" Foreground="#0C3026" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="minana" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="NETWORK UTILITIES" FontSize="10" Foreground="{StaticResource Muted}" Margin="1,10,0,34"/>
          <Button x:Name="AdaptersNav" Click="Adapters_Click" HorizontalContentAlignment="Left" Background="#203D38" BorderBrush="#315D51" Foreground="{StaticResource Accent}" Padding="14,13" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="MAC changer" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></StackPanel></Button>
          <Button Click="Guide_Click" Background="Transparent" BorderThickness="0" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Quick guide"/></StackPanel></Button>
          <Button Click="About_Click" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="About Minana"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border Background="#15251F" CornerRadius="7" Padding="10,8" Margin="0,0,0,16"><TextBlock Text="●  Runs locally" Foreground="{StaticResource Accent}" FontSize="12"/></Border>
          <TextBlock Text="Built by Minana Tech" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="minanatech.com  ↗" Click="Website_Click" Padding="0,8" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Foreground="{StaticResource Muted}" FontSize="12"/>
          <TextBlock Text="v0.1.0  /  Open source" Style="{StaticResource Caption}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,25,30,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,18">
        <StackPanel><TextBlock Text="YOUR NETWORK. YOUR CONTROL." FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,7"/><TextBlock Text="MAC Address Changer" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Manage your adapter identity with confidence." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
        <Button x:Name="RefreshButton" Content="↻  Refresh adapters" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click" ToolTip="Read the latest adapter status"/>
      </Grid>
      <Grid x:Name="Workspace" Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="16">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="2,2,2,16"><TextBlock Text="Network adapters" FontWeight="SemiBold"/><TextBlock x:Name="AdapterCount" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
            <TextBox x:Name="SearchBox" Tag="Search adapters…" Grid.Row="1" FontSize="12" Padding="10" TextChanged="Search_Changed" ToolTip="Filter by adapter name or description" AutomationProperties.Name="Search network adapters" Margin="0,0,0,14"/>
            <Grid Grid.Row="2"><ListBox x:Name="AdapterList" Foreground="{StaticResource Ink}" Background="Transparent" BorderThickness="0" SelectionChanged="Adapter_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Network adapters">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Padding" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="#172232" BorderBrush="#273345" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1A3432"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#75E5C0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#233C46"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="175" TextWrapping="NoWrap"/></StackPanel><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,9,0,7" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox><TextBlock x:Name="EmptyAdapters" Text="No adapters found.&#x0a;Refresh to try again." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
            <StackPanel Grid.Row="3" Margin="2,16,2,2"><TextBlock Text="SELECT AN ADAPTER TO BEGIN" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock Text="Driver support varies by device." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,15">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SELECTED ADAPTER" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="AdapterName" Text="Select an adapter" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,7,12,0" FontSize="23" FontWeight="SemiBold"/></StackPanel><Border Grid.Column="1" Background="#203830" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="9,5"><TextBlock x:Name="ConnectionStatus" Text="—" Foreground="{StaticResource Accent}" FontSize="11"/></Border></Grid>
                <TextBlock x:Name="AdapterDescription" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,14"/>
                <Border Background="#0D1521" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="15">
                  <Grid><StackPanel><TextBlock Text="CURRENT MAC ADDRESS" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentMac" Text="—" FontFamily="Consolas" FontSize="25" Margin="0,7,0,8"/><TextBlock x:Name="OverrideState" Text="Waiting for adapter selection" FontSize="11" Foreground="{StaticResource Accent}"/></StackPanel><Button x:Name="CopyButton" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10" Click="Copy_Click" ToolTip="Copy current MAC address" AutomationProperties.Name="Copy current MAC address"/></Grid>
                </Border>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IPv4 ADDRESS" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock x:Name="IpAddress" Text="—" FontFamily="Consolas" FontSize="12" Margin="0,6,8,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LINK SPEED" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LinkSpeed" Text="—" FontSize="12" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DEFAULT GATEWAY" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Gateway" Text="—" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"/></StackPanel></Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,15">
              <StackPanel><Grid><TextBlock Text="Change MAC address" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="01 / CONFIGURE" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                <TextBlock Text="Set a custom address or generate a random one." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,12"/>
                <TextBlock Text="New MAC address" FontSize="12" Margin="0,0,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MacInput" FontFamily="Consolas" FontSize="22" Padding="12,11" MaxLength="32" TextChanged="Mac_Changed" AutomationProperties.Name="New MAC address" VerticalContentAlignment="Center"/><Button x:Name="RandomButton" Grid.Column="2" Content="↻  Randomize" Click="Random_Click" ToolTip="Generate a locally administered unicast MAC address"/></Grid>
                <TextBlock x:Name="Validation" Text="Format: 02:1A:2B:3C:4D:5E" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,12"/>
                <Border Background="#26251E" CornerRadius="7" Padding="12"><TextBlock Text="Your adapter will restart. Its connection will briefly drop, including any active remote session using it." Foreground="#DAC99F" FontSize="12"/></Border>
                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ApplyButton" Content="Apply MAC address  →" Style="{StaticResource Primary}" Click="Apply_Click" IsEnabled="False"/><Button x:Name="RestoreButton" Grid.Column="2" Content="Restore default" Click="Restore_Click" ToolTip="Remove the software override and restart the adapter"/></Grid>
                <TextBlock Text="Administrator approval is requested when you apply a change." FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18,12"><StackPanel><TextBlock Text="Session activity" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/><TextBlock x:Name="Activity" Text="Ready. Select an adapter to get started." Foreground="{StaticResource Muted}" FontSize="11" LineHeight="19"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border x:Name="InfoPanel" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="InfoTitle" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock x:Name="InfoText" Foreground="#B8C7D8" FontSize="15" LineHeight="27"/><Button Content="←  Back to MAC changer" Click="Adapters_Click" HorizontalAlignment="Left" Margin="0,30,0,0"/></StackPanel></ScrollViewer></Border>
      <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="Loading adapters…" FontSize="11" Foreground="{StaticResource Muted}" MaxWidth="690" HorizontalAlignment="Left"/><TextBlock Text="MINANA TECH" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
    </Grid>
  </Grid>
</Window>



